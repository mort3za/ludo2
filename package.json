{
  "name": "ludo-2",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,vue}": ["oxfmt", "oxlint"]
  },
  "private": true,
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "tsc -b"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged && bun run types && bun run test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}