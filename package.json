{
  "name": "ludo-2",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "lint": "oxlint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged && bun run typecheck && bun run test"
  },
  "lint-staged": {
    "*.{ts,vue}": "oxlint"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "lint-staged": "^16.1.0",
    "oxlint": "^1.62.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
