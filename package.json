{
  "name": "ludo-2",
  "version": "0.3.0",
  "description": "Real-time multiplayer Ludo game",
  "keywords": [
    "board-game",
    "game",
    "ludo",
    "multiplayer",
    "real-time"
  ],
  "license": "UNLICENSED",
  "author": "Morteza Ziyaeimehr <morteza.zym@gmail.com>",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "bun run --filter '*' typecheck"
  },
  "dependencies": {
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.62.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged && bun run types && bun run test"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxfmt",
      "oxlint"
    ],
    "*.{json,css,md,html}": [
      "oxfmt"
    ]
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
