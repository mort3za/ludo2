{
  "name": "ludo-2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "tsc -b"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.62.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged && bun run types && bun run test"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxfmt",
      "oxlint"
    ]
  }
}
